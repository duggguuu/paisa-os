# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres@localhost:5432/paisa
# 32+ random characters. Used to sign cookies and encrypt your Kite secret/token. Never change it after setup.
# Generate one with: openssl rand -base64 48
APP_SECRET=
# The public URL the app is served from (Kite redirects back here)
PUBLIC_URL=http://localhost:8080
PORT=8080
# Optional: max DB connections (default 10). 5 is plenty on Neon's free tier.
# DB_POOL_MAX=5
# Optional: set to 1 when behind a reverse proxy (automatic on Render).
# TRUST_PROXY=1
